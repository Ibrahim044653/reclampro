# Configuration RéclamPro — copier ce fichier en `.env` et adapter pour la prod.
# .env est lu automatiquement par docker compose.

# ----- Base de données PostgreSQL -----
POSTGRES_DB=reclampro
POSTGRES_USER=reclampro
POSTGRES_PASSWORD=changez-moi-en-production

# ----- Secrets applicatifs -----
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=remplacez-par-une-cle-aleatoire-de-au-moins-32-caracteres
APP_CRYPTO_KEY=remplacez-par-une-autre-cle-aleatoire-de-32-caracteres

# ----- Seed des données de démo au premier démarrage -----
# true → 6 agents, 7 clients, 25 réclamations seedés si DB vide
# false → DB vierge (recommandé en prod)
SEED_AT_STARTUP=true

# ----- Email sortant (ACR + notifications clôture) -----
EMAIL_DRIVER=console
# Pour activer SMTP réel :
# EMAIL_DRIVER=smtp
# SMTP_HOST=smtp.banque.ci
# SMTP_PORT=587
# SMTP_USER=reclamations@banque.ci
# SMTP_PASSWORD=changez-moi
# SMTP_TLS=true
# SMTP_FROM=reclamations@banque.ci

# ----- WhatsApp Business Cloud API (Meta) -----
WHATSAPP_DRIVER=console
# Pour activer :
# WHATSAPP_DRIVER=cloud
# WHATSAPP_TOKEN=EAAxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_VERIFY_TOKEN=token-de-webhook-fort
